# ============================================================
# SAMPLE CONFIGURATION — update all values before running.
# Do NOT commit this file with real credentials.
# ============================================================

SQLSERVER_HOST=url
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=database_name

# Authentication type (default: sql)
# Options: sql | windows | azure_ad_password | azure_ad_integrated | azure_ad_service_principal | azure_ad_msi
SQLSERVER_AUTH_TYPE=sql

# --- SQL Server / Azure AD password auth ---
SQLSERVER_USERNAME=user_name
SQLSERVER_PASSWORD=password

# --- Azure AD Service Principal auth ---
# SQLSERVER_CLIENT_ID=your-app-client-id
# SQLSERVER_CLIENT_SECRET=your-client-secret

# Optional: set to "yes" to trust self-signed certs
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
